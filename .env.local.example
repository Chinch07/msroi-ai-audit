# ─── Core services ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
AHREFS_MCP_KEY=your-ahrefs-mcp-key-here
RESEND_API_KEY=your-resend-api-key-here

# Vercel Blob. Auto-populated when a Blob store is connected to the project;
# set it locally too if you run `next dev` against real storage.
# Required for: the audit cache, the free-audit 3-credit limit, the member
# monthly quota, and every auth single-use claim (magic links, credit-token
# call bounding, refunds, sign-in cooldown). All of those fail CLOSED if this
# is missing — which means a real storage outage looks like "everything is
# being rejected" rather than like a quiet bypass.
BLOB_READ_WRITE_TOKEN=

# ─── Auth ─────────────────────────────────────────────────────────────────
# Long random string, server-only. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also derives the ids in /audit/<id> preview links, so rotating it
# invalidates links already shared. The audits themselves survive — reopen
# one from the tool to get its new link.
AUTH_SECRET=

# Internal staff: unlimited audits, full Ahrefs enrichment.
# Entries with '@' match an exact email; entries without match a whole domain.
INTERNAL_ALLOWLIST=mainstreetroi.com

# Member clients: MEMBER_MONTHLY_LIMIT audits per calendar month.
# Deliberately empty by default and listed as individual addresses — a bare
# domain here would grant a paid quota to everyone at that company.
# Example: MEMBER_ALLOWLIST=jane@clientco.com,ops@anotherclient.com
MEMBER_ALLOWLIST=

# Audits per member per month. Resets on the 1st (UTC). Defaults to 10 if
# unset or invalid — a typo here must not silently mean "zero audits."
MEMBER_MONTHLY_LIMIT=10

# Sender for sign-in and lead emails. onboarding@resend.dev works for testing
# but only reliably delivers to your own Resend account address — use a
# verified domain before giving the link to anyone else.
MAIL_FROM=Main Street ROI <ai@mainstreetroi.com>

# Absolute base URL for magic-link emails. REQUIRED on Vercel (Production AND
# Preview). The app refuses to derive it from request headers there, since
# Host/X-Forwarded-Host are client-influenced and must never determine where
# a login link points. Only local `next dev` falls back to auto-detection.
# NOTE: this differs per environment — a Preview deployment needs its own
# preview URL here, or sign-in links from preview will land on production.
APP_BASE_URL=https://msroi-ai-audit.vercel.app

# ─── Notifications ────────────────────────────────────────────────────────
# Where /free-audit lead submissions are emailed.
LEAD_NOTIFY_TO=info@mainstreetroi.com

# ─── Optional ─────────────────────────────────────────────────────────────
# Google Tag Manager container. Leave unset to inject no GTM at all.
# NEXT_PUBLIC_ is required (it's inlined at build time), so changing it
# needs a redeploy, not just an env edit.
NEXT_PUBLIC_GTM_ID=
